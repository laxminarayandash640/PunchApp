# ==============================================================================
# Employee Attendance & Timesheet Management System — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase — required for all environments
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# ------------------------------------------------------------------------------

# The public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# The anon/public key (safe to expose to the browser — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The service-role secret key (server-side ONLY — bypasses RLS)
# Used exclusively in Next.js API Route Handlers (never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# Canonical public URL of this app (used for redirects, emails, og:url, etc.)
# Local development: http://localhost:3000
# Production:        https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Optional — Auth email redirect (Supabase email confirmation deep-link)
# Leave blank to use the Supabase project default.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# Optional — Analytics / Monitoring (add as needed)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
